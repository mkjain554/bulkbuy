generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum PoolStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  TARGET_REACHED
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum FormFieldType {
  TEXT
  DROPDOWN
  DATE
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(80)
  email          String              @unique @db.VarChar(254)
  passwordHash   String
  role           UserRole            @default(BUYER)
  status         AccountStatus       @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessions       Session[]
  products       Product[]
  participations PoolParticipation[]
  notifications  Notification[]
  auditLogs      AuditLog[]          @relation("AuditActor")

  @@index([role, status])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  sellerId    String          @db.Uuid
  categoryId  String          @db.Uuid
  name        String          @db.VarChar(120)
  brand       String          @db.VarChar(80)
  description String          @db.Text
  sku         String?         @db.VarChar(80)
  imageUrl    String?         @db.VarChar(2048)
  status      ProductStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  seller      User            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pools       Pool[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([name])
}

model Pool {
  id              String              @id @default(uuid()) @db.Uuid
  productId       String              @db.Uuid
  title           String              @db.VarChar(140)
  description     String              @db.Text
  regularPrice    Decimal             @db.Decimal(12, 2)
  groupPrice      Decimal             @db.Decimal(12, 2)
  currency        String              @default("INR") @db.Char(3)
  minBuyers       Int
  maxParticipants Int?
  startsAt        DateTime
  closesAt        DateTime
  status          PoolStatus          @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  formFields      PoolFormField[]
  participations  PoolParticipation[]

  @@index([status, closesAt])
  @@index([productId, status])
}

model PoolFormField {
  id           String                    @id @default(uuid()) @db.Uuid
  poolId       String                    @db.Uuid
  label        String                    @db.VarChar(80)
  type         FormFieldType
  required     Boolean                   @default(false)
  config       Json
  displayOrder Int
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  pool         Pool                      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  values       ParticipationFieldValue[]

  @@unique([poolId, displayOrder])
  @@index([poolId, displayOrder])
}

model PoolParticipation {
  id        String                    @id @default(uuid()) @db.Uuid
  poolId    String                    @db.Uuid
  buyerId   String                    @db.Uuid
  createdAt DateTime                  @default(now())
  pool      Pool                      @relation(fields: [poolId], references: [id], onDelete: Restrict)
  buyer     User                      @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  values    ParticipationFieldValue[]

  @@unique([poolId, buyerId])
  @@index([poolId, createdAt])
  @@index([buyerId, createdAt])
}

model ParticipationFieldValue {
  id              String            @id @default(uuid()) @db.Uuid
  participationId String            @db.Uuid
  fieldId         String            @db.Uuid
  value           String?           @db.Text
  participation   PoolParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  field           PoolFormField     @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([participationId, fieldId])
  @@index([fieldId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    @db.VarChar(80)
  message   String    @db.VarChar(500)
  readAt    DateTime?
  dedupeKey String?   @unique @db.VarChar(180)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(80)
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
